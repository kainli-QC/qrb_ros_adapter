// Intentionally no include guard: this is the single declarative mapping list
// expanded independently by the shared, HCM and ROS registries.

#if defined( QRB_CONTRACT_MAPPING_INCLUDE_HCM_HEADERS )
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/image_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/detection_2d_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/detection_3d_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/joint_state_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/odometry_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/point_cloud_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/pose_array_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/imu_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/pose_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/pose_stamped_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/tf_message_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/twist_hcm_converter.hpp"
#include "qrb_ros_adapter/hcm_ipc_adapter/flow_client/vector3_stamped_hcm_converter.hpp"
#endif

#if defined( QRB_CONTRACT_MAPPING_INCLUDE_ROS_HEADERS )
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/image_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/detection_2d_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/detection_3d_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/joint_state_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/odometry_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/point_cloud_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/pose_array_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/imu_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/pose_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/pose_stamped_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/tf_message_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/twist_ros_converter.hpp"
#include "qrb_ros_adapter/ros_ipc_bridge/flow_bridge/vector3_stamped_ros_converter.hpp"
#endif

#if defined( QRB_CONTRACT_MAPPING )
QRB_CONTRACT_MAPPING( PoseWithCovarianceStamped,
    "qrb.contract.geometry.v1.PoseWithCovarianceStamped", Inline,
    ::qrb::contract::geometry::v1::PoseWithCovarianceStamped,
    ::qrb::adapter::PoseHcmDescriptor,
    ::qrb::adapter::PoseRosMessage, "pose_bridge" )

QRB_CONTRACT_MAPPING( PointCloud,
    "qrb.contract.sensor.v1.PointCloud2", DmaBuf,
    ::qrb::contract::sensor::v1::PointCloud2,
    ::qrb::adapter::PointCloudHcmDescriptor,
    ::qrb::adapter::PointCloudRosMessage, "pointcloud_bridge" )

QRB_CONTRACT_MAPPING( Odometry,
    "qrb.contract.nav.v1.Odometry", Inline,
    ::qrb::contract::nav::v1::Odometry,
    ::qrb::adapter::OdometryHcmDescriptor,
    ::qrb::adapter::OdometryRosMessage, "odometry_bridge" )

QRB_CONTRACT_MAPPING( TwistStamped,
    "qrb.contract.geometry.v1.TwistStamped", Inline,
    ::qrb::contract::geometry::v1::TwistStamped,
    ::qrb::adapter::TwistHcmDescriptor,
    ::qrb::adapter::TwistRosMessage, "twist_bridge" )

// The HCM descriptor keeps its transforms in host storage (heap or a local
// DMA-BUF); across IPC they travel Inline, so ROS gets a plain message.
QRB_CONTRACT_MAPPING( TFMessage,
    "qrb.contract.tf2.v1.TFMessage", Inline,
    ::qrb::contract::tf2::v1::TFMessage,
    ::qrb::adapter::TFMessageHcmDescriptor,
    ::qrb::adapter::TFMessageRosMessage, "tf_message_bridge" )

QRB_CONTRACT_MAPPING( Image,
    "qrb.contract.sensor.v1.ImageLayout", DmaBuf,
    ::qrb::contract::sensor::v1::ImageLayout,
    ::qrb::adapter::ImageHcmDescriptor,
    ::qrb::adapter::ImageRosMessage, "image_bridge" )

// The joint-record buffer stays in host storage; only the protobuf travels across IPC.
QRB_CONTRACT_MAPPING( JointState,
    "qrb.contract.sensor.v1.JointState", Inline,
    ::qrb::contract::sensor::v1::JointState,
    ::qrb::adapter::JointStateHcmDescriptor,
    ::qrb::adapter::JointStateRosMessage, "joint_state_bridge" )

QRB_CONTRACT_MAPPING( PoseStamped,
    "qrb.contract.geometry.v1.PoseStamped", Inline,
    ::qrb::contract::geometry::v1::PoseStamped,
    ::qrb::adapter::PoseStampedHcmDescriptor,
    ::qrb::adapter::PoseStampedRosMessage, "pose_stamped_bridge" )

// The HCM descriptor keeps its poses in its buffer; across IPC they travel
// Inline, so ROS gets a plain message.
QRB_CONTRACT_MAPPING( PoseArray,
    "qrb.contract.geometry.v1.PoseArray", Inline,
    ::qrb::contract::geometry::v1::PoseArray,
    ::qrb::adapter::PoseArrayHcmDescriptor,
    ::qrb::adapter::PoseArrayRosMessage, "pose_array_bridge" )

QRB_CONTRACT_MAPPING( Vector3Stamped,
    "qrb.contract.geometry.v1.Vector3Stamped", Inline,
    ::qrb::contract::geometry::v1::Vector3Stamped,
    ::qrb::adapter::Vector3StampedHcmDescriptor,
    ::qrb::adapter::Vector3StampedRosMessage, "vector3_stamped_bridge" )

QRB_CONTRACT_MAPPING( Imu,
    "qrb.contract.sensor.v1.Imu", Inline,
    ::qrb::contract::sensor::v1::Imu,
    ::qrb::adapter::ImuHcmDescriptor,
    ::qrb::adapter::ImuRosMessage, "imu_bridge" )

// Detections are Inline Contracts: the Contract carries every detection. The HCM descriptor keeps
// its fixed-size records in its own buffer, which the HCM converter reads or fills.
QRB_CONTRACT_MAPPING( Detection2DArray,
    "qrb.contract.vision.v1.Detection2DArray", Inline,
    ::qrb::contract::vision::v1::Detection2DArray,
    ::qrb::adapter::Detection2DHcmDescriptor,
    ::qrb::adapter::Detection2DRosMessage, "detection2d_bridge" )

QRB_CONTRACT_MAPPING( Detection3DArray,
    "qrb.contract.vision.v1.Detection3DArray", Inline,
    ::qrb::contract::vision::v1::Detection3DArray,
    ::qrb::adapter::Detection3DHcmDescriptor,
    ::qrb::adapter::Detection3DRosMessage, "detection3d_bridge" )
#endif
